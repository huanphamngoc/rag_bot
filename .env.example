# Copy to .env (git-ignored).

# ---- vector database (service vectordb) ----
VECTORDB_DB=rag
VECTORDB_USER=rag
# letters and digits only (it goes into a connection URL): python -c "import secrets; print(secrets.token_hex(16))"
VECTORDB_PASSWORD=
VECTORDB_HOST_PORT=5434

# ---- source: the crawler's Postgres, read-only ----
# Role analyst_ro of the crawler project: its password is ANALYST_RO_PASSWORD in E:/Job/crawler/.env
SOURCE_PG_HOST=host.docker.internal
SOURCE_PG_PORT=5433
SOURCE_PG_DB=crawler
SOURCE_PG_USER=analyst_ro
SOURCE_PG_PASSWORD=

# ---- models (same names and meaning as in the crawler project) ----
# The embedding model must stay the same for the life of the index: `init` pins provider/model/dimension.
RAG_EMBED_PROVIDER=vertex
RAG_EMBED_MODEL=gemini-embedding-001
RAG_EMBED_DIM=1536
RAG_EMBED_BATCH=64
RAG_CHAT_PROVIDER=vertex
RAG_CHAT_MODEL=gemini-2.5-flash
RAG_CHAT_MAX_TOKENS=4096
RAG_CHAT_TEMPERATURE=0.1
RAG_VERTEX_PROJECT=
RAG_VERTEX_LOCATION=us-central1
# Vertex AI login of this machine (gcloud auth application-default login); Linux/macOS: ~/.config/gcloud
GCLOUD_CONFIG=
# Other providers: RAG_EMBED_API_KEY / RAG_CHAT_API_KEY / RAG_*_BASE_URL, as in the crawler's .env

# ---- documents, retrieval, web ----
RAG_DOC_TYPES=drug_recall,cpsc_recall
RAG_CHUNK_CHARS=1600
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=8
RAG_CANDIDATES=40
RAG_WEB_DAILY_LIMIT=300
# Ask again, with examples built from the index, when a question names a subject but asks nothing
# ("insulin"). The turn pauses (a LangGraph interrupt in the `graph` schema) and resumes with the
# corrected question. false = such a question gets its message and ends there.
RAG_CHAT_CLARIFY=true
WEB_HOST_PORT=8089

# ---- business rules (YAML) ----
# Folder describing the document types, their quality rules and the chat input gate. Mounted into the
# container from ./app/rules, so it can be edited without rebuilding the image.
RULES_DIR=rules

# ---- ingestion ----
INGEST_PAGE_DOCS=2000
# pause between incremental runs of the scheduler service (seconds)
INGEST_INTERVAL_S=900
# Pause the run before embedding when it would send more than this many distinct chunk texts, and wait
# for `crawlerrag approve <thread_id>`. 0 = never pause. Needs INGEST_GRAPH_CHECKPOINT=true, since a
# pause is a LangGraph interrupt that has to be stored somewhere to be answered.
INGEST_EMBED_APPROVAL_CHUNKS=0
# Store the LangGraph state after each node (schema `graph`), so a run that died inside a node can be
# resumed there. What gets read from the source is still decided by ingest.watermark.
INGEST_GRAPH_CHECKPOINT=true

# ---- MLflow tracing (profile "mlflow"; tracing is off while MLFLOW_TRACKING_URI is empty) ----
#   docker compose --profile mlflow up -d --build     UI: http://localhost:5001
# The server stores traces in its own "mlflow" database inside the vectordb container.
MLFLOW_DB_PASSWORD=
# Set to http://mlflow:5000 (the service name inside this compose network) to start recording traces.
MLFLOW_TRACKING_URI=
MLFLOW_HOST_PORT=5001
# Where the CLI should point you for a trace it just recorded; defaults to localhost:MLFLOW_HOST_PORT.
MLFLOW_UI_URL=
MLFLOW_EXPERIMENT_NAME=crawler-rag
LOG_FORMAT=json
